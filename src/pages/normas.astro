---
import Layout from "../layouts/Layout.astro";
import { normas } from "../data/normas";
---

<Layout
  title="Normativas | DEVANK RP"
  description="Reglamento oficial y normativas de convivencia de Devank Roleplay."
>
    <main class="paper min-h-screen">
    <div class="mx-auto max-w-7xl px-5 py-10 sm:px-8 lg:py-16">
    <header class="mb-12">
      <a
        href="/"
        class="font-typewriter text-xs uppercase tracking-widest opacity-60 transition-opacity hover:opacity-100"
      >
        ← Volver al inicio
      </a>

      <div class="mt-10 text-center">
        <span class="ribbon font-display text-2xl uppercase sm:text-3xl">
          Documentación oficial
        </span>

        <h1 class="mt-6 font-display text-5xl uppercase leading-tight sm:text-7xl">
          Normas del servidor.
        </h1>

        <p class="mx-auto mt-5 max-w-2xl font-typewriter text-sm leading-relaxed sm:text-base">
          Este documento establece las disposiciones que regulan la convivencia, la interpretación
          y el desarrollo de las actividades dentro del servidor.
        </p>
        <p class="mx-auto mt-5 max-w-3xl font-typewriter text-sm text-red underline leading-relaxed sm:text-base">
            El desconocimiento de las normativas no justifica su acciones.</p>
      </div>
    </header>

    <hr class="rule-double" />

    <!-- Información del documento -->
    <div class="flex flex-wrap items-center justify-between gap-3 py-5 font-typewriter text-xs uppercase tracking-wider opacity-60">
      <span>DEVANK RP · Reglamento oficial</span>
      <span>{normas.length} capítulos · {
        normas.reduce((total, capitulo) => total + capitulo.articles.length, 0)
      } artículos</span>
    </div>

    <hr class="border-ink/40" />

    <!-- Contenido -->
    <div class="grid gap-12 py-10 lg:grid-cols-[260px_1fr] lg:gap-16">

      <!-- Índice lateral -->
      <aside class="lg:sticky lg:top-8 lg:h-fit">
        <div class="border border-ink/40 p-5">
          <span class="ribbon font-display text-xl uppercase">
            Contenido
          </span>

          <nav class="mt-6">
            <ul class="space-y-1">
              {normas.map((capitulo) => (
                <li>
                  <a
                    href={`#${capitulo.id}`}
                    class="group flex items-start gap-3 py-3 font-typewriter text-xs leading-relaxed transition-colors hover:text-amber-800"
                  >
                    <span class="font-display text-lg opacity-40 transition-opacity group-hover:opacity-100">
                      {capitulo.number}
                    </span>

                    <span class="pt-1 uppercase">
                      {capitulo.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <hr class="my-5 border-ink/30" />

          <a
            href="/"
            class="block text-center font-display text-sm uppercase tracking-wide transition-opacity hover:opacity-60"
          >
            Volver al inicio →
          </a>
        </div>
      </aside>

      <!-- Capítulos -->
      <div class="min-w-0 space-y-16">
        {normas.map((capitulo) => (
          <section
            id={capitulo.id}
            class="scroll-mt-24"
          >
            <!-- Título del capítulo -->
            <div class="border-b-2 border-ink/50 pb-6">
              <span class="font-typewriter text-xs uppercase tracking-[0.2em] opacity-50">
                Capítulo {capitulo.number}
              </span>

              <h2 class="mt-3 font-display text-3xl uppercase leading-tight sm:text-4xl">
                {capitulo.title}
              </h2>

              <p class="mt-4 max-w-2xl font-typewriter text-sm leading-relaxed opacity-80">
                {capitulo.description}
              </p>
            </div>

            <!-- Artículos -->
            <div class="divide-y divide-ink/25">
              {capitulo.articles.map((articulo, index) => (
                <article class="py-6">
                  <div class="flex items-start gap-4">
                    <span class="shrink-0 pt-1 font-typewriter text-xs opacity-40">
                      {capitulo.number}.{String(index + 1).padStart(2, "0")}
                    </span>

                    <div class="min-w-0">
                      <h3 class="font-display text-xl uppercase">
                        {articulo.title}
                      </h3>

                      <p class="mt-3 font-paper text-base leading-7">
                        {articulo.content}
                      </p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}

        <!-- Cierre -->
        <footer class="border-t-2 border-ink/50 pt-8 text-center">
          <span class="font-typewriter text-xs uppercase tracking-widest opacity-50">
            Devank Roleplay
          </span>

          <h2 class="mt-4 font-display text-3xl uppercase">
            Una vida. Un destino.
          </h2>

          <p class="mt-3 font-typewriter text-sm opacity-70">
            El respeto por las reglas mantiene viva nuestra comunidad.
          </p>

          <a
            href="/"
            class="mt-7 inline-flex items-center gap-3 border border-ink px-7 py-3 font-display uppercase transition-colors hover:bg-ink hover:text-paper"
          >
            ← Regresar al inicio
          </a>
        </footer>
      </div>
    </div>
    </div>
  </main>
</Layout>
